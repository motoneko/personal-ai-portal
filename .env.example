PORTAL_ORIGIN=https://portal.example.com
PORTAL_PASSWORD=replace-with-a-long-random-password
PORTAL_API_KEY=
PORTAL_MODEL=gpt-6.1-sol
PORTAL_IMAGE_MODEL=gpt-image-1
UPSTREAM_URL=http://sub2api:8080
QUOTA_URL=http://sub2api-quota-viewer:8080
PORTAL_SECURE_COOKIE=true
PORTAL_NETWORK=sub2api-deploy_sub2api-network
# Exact CIDR of the HAProxy host as observed by the container (verify your network).
# The proxy MUST overwrite X-Portal-Client-IP before enabling this.
PORTAL_TRUSTED_PROXIES=
